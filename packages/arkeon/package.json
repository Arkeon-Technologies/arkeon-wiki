{
  "name": "arkeon-wiki",
  "version": "0.1.1",
  "description": "Filesystem-first substrate for agent harnesses: Hono API server, SQLite index, CLI. Ships as an npm package and a Docker image (ghcr.io/arkeon-technologies/arkeon-wiki).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arkeon-Technologies/arkeon-wiki.git",
    "directory": "packages/arkeon"
  },
  "type": "module",
  "bin": {
    "arkeon-wiki": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "bundle-schema": "tsx scripts/copy-schema.ts",
    "bundle-extractor-scripts": "tsx scripts/copy-extractor-scripts.ts",
    "prepack": "npm run build",
    "build": "tsup && npm run bundle-schema && npm run bundle-extractor-scripts",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "better-sqlite3": "^12.9.0",
    "commander": "^14.0.1",
    "hono": "^4.12.9",
    "node-html-parser": "^7.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.6.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Arkeon Technologies, Inc.",
  "license": "Apache-2.0"
}
