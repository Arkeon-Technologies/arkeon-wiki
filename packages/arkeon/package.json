{
  "name": "arkeon-wiki",
  "version": "0.1.1",
  "description": "Self-contained wiki + knowledge-graph platform: Hono API server, SQLite, CLI. One package, one process, no Docker.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arkeon-Technologies/arkeon-wiki.git",
    "directory": "packages/arkeon"
  },
  "type": "module",
  "bin": {
    "arkeon-wiki": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "fetch-spec": "tsx scripts/fetch-openapi.ts",
    "generate": "tsx scripts/generate-commands.ts",
    "bundle-assets": "tsx scripts/bundle-assets.ts",
    "bundle-explorer": "npm run build -w @arkeon-wiki/explorer && tsx scripts/copy-explorer.ts",
    "bundle-schema": "tsx scripts/copy-schema.ts",
    "bundle-spec": "tsx scripts/copy-spec.ts",
    "prepack": "npm run build",
    "build": "npm run fetch-spec && npm run generate && npm run bundle-assets && tsup && npm run bundle-explorer && npm run bundle-schema && npm run bundle-spec",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:manual": "vitest run --config vitest.manual.config.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@hono/zod-openapi": "^1.2.3",
    "@vscode/ripgrep": "^1.17.1",
    "better-sqlite3": "^12.9.0",
    "commander": "^14.0.1",
    "conf": "^13.0.1",
    "dotenv": "^17.3.1",
    "hono": "^4.12.9",
    "js-yaml": "^4.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.6.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Arkeon Technologies, Inc.",
  "license": "Apache-2.0"
}
